%%{init: {"flowchart": {"rankSpacing": 28, "nodeSpacing": 24, "padding": 12, "subGraphTitleMargin": {"top": 6, "bottom": 16}}, "themeVariables": {"fontSize": "18px"}}}%%
flowchart TB
  classDef captain fill:#F8E6C4,stroke:#A56A12,color:#2C1A00,stroke-width:1.5px
  classDef officer fill:#E6D4F5,stroke:#6B3FA0,color:#241036,stroke-width:1.5px
  classDef worker fill:#C9EDE8,stroke:#1A7A6D,color:#06332E,stroke-width:1.5px
  classDef record fill:#F1F5F9,stroke:#64748B,color:#172B32,stroke-width:1.5px

  subgraph captain_side["Your workstation · Captain identity"]
    captain["You · Captain"]:::captain
    officer["First officer<br/>Your account + credentials"]:::officer
    captain -->|"Plan, then delegate"| officer
  end
  github["GitHub<br/>Issues · PRs · reviews · checks"]:::record
  subgraph compose["Docker Compose · worker identity"]
      poller["Issue + review poller"]:::record
      kanban["Hermes Kanban"]:::record
      worker["Hermes worker<br/>Own account + token"]:::worker
      poller -->|"Assign task"| kanban -->|"Execute"| worker
    state[("Persistent worker state<br/>/opt/data")]:::record
    kanban -.- state
    worker -.- state
  end
  officer -->|"Assign · review · authorized merge"| github
  github -->|"PRs + checks"| officer
  github -->|"Issues + feedback"| poller
  worker -->|"Commits + PRs"| github
  style captain_side fill:#F8F4FC,stroke:#6B3FA0,color:#241036
  style compose fill:#EFFAF7,stroke:#1A7A6D,color:#06332E
