# Copy to deploy/.env and replace CHANGE_ME values.
# Never commit a populated .env.

# Fine-grained or classic PAT for the configured policy github_identity.
HERMES_GITHUB_TOKEN=CHANGE_ME_GITHUB_TOKEN

# Optional overrides.
# HERMES_HELMET_IMAGE=ghcr.io/machinewisdomai/hermes-helmet-oss:dev-local
# Policy path is relative to deploy/ (compose file dir). Default matches quickstart.
# HERMES_HELMET_POLICY_HOST_PATH=../config/policy.json
# HERMES_DASHBOARD=0
# HERMES_DASHBOARD_HOST_PORT=9119
# HERMES_BASE_IMAGE=nousresearch/hermes-agent:v2026.9.14@sha256:99641e57ec762c59e54cb44aa6746b7fc68c18b3c5ddb088af54234c613d9294
